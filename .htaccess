<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive dot files and database
    RewriteRule ^(^\.|database|storage/logs) - [F,L]

    # Route all requests to the Laravel public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
